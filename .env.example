# Admin Credentials for Student Lost & Found Admin Portal
ADMIN_EMAIL="admin@campus.edu"
ADMIN_PASSWORD="admin123"

# Port the Express server listens on
PORT=3000

# PostgreSQL Database Configuration
# Provide DATABASE_URL or individual PG credentials to connect to your PostgreSQL database.
# (If omitted, the application uses local SQLite fallback storage)
DATABASE_URL=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSL=false
